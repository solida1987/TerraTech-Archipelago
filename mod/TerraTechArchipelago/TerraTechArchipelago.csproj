<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The game runs Mono on .NET Framework 4.x. net472 is what its own
         assemblies target, so this is what a mod must target to load. -->
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>TerraTechArchipelago</AssemblyName>
    <RootNamespace>TerraTechArchipelago</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Version>0.1.0</Version>
    <Company>solida1987</Company>
    <Product>TerraTech Archipelago</Product>
    <!-- The game's assemblies are NOT redistributed with this repository.
         Everything the mod needs from TerraTech is resolved by name at
         runtime (see Reflect.cs), so a clone builds without owning a copy
         of the game's code. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Harmony is the only outside dependency. It is what makes a mod for a
         game with no official modding API possible at all. -->
    <PackageReference Include="Lib.Harmony" Version="2.2.2" />
  </ItemGroup>

</Project>
